<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="TopThird" style="flex-grow: 1; align-items: center; align-self: stretch;">
        <ui:Image name="SwitchIcon"/>
    </ui:VisualElement>
    <ui:VisualElement name="CornerStats" style="flex-grow: 1; align-self: flex-end; justify-content: flex-end; flex-direction: row; height: 10%; bottom: 0; right: 0; max-height: 84px;">
        <ui:Image name="PillIcon"/>
        <ui:Label text="Label" name="PillCounter"/>
    </ui:VisualElement>
</ui:UXML>
