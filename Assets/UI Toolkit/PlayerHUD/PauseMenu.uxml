<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <DesktopWindowElement style="height: 100%; width: 100%; align-items: center; justify-content: center;">
        <ui:VisualElement name="DocumentWindow" style="flex-grow: 0; position: relative; width: 50%; height: 40%; top: 0%; left: 0%; border-top-width: 4px; border-left-width: 4px; border-bottom-width: 4px; border-right-width: 4px; border-left-color: rgb(117, 140, 149); border-top-color: rgb(117, 140, 149); border-bottom-color: rgb(117, 140, 149); border-right-color: rgb(117, 140, 149); bottom: auto; right: auto; align-self: auto; align-content: auto; align-items: flex-start; justify-content: center; flex-shrink: 1; flex-direction: column;">
            <ui:VisualElement name="WindowBar" style="flex-grow: 0; top: 0; height: 36px; background-color: rgb(75, 137, 212); justify-content: space-between; flex-direction: row; width: 100%; align-items: stretch; flex-shrink: 0;">
                <ui:Label text="Paused" name="WindowTitle" style="left: 0; margin-left: 8px; margin-bottom: 4px; flex-shrink: 1; font-size: 24px; justify-content: center; align-content: center; margin-top: 4px; padding-top: 0; padding-bottom: 0; color: rgb(255, 255, 255); -unity-font-style: bold; flex-grow: 1; align-items: stretch;"/>
            </ui:VisualElement>
            <ui:VisualElement name="WindowContents" style="flex-grow: 1; background-color: rgb(231, 231, 231); align-content: center; align-items: center; justify-content: space-evenly; align-self: auto; width: 100%; height: auto; flex-shrink: 0; left: 0; top: 0; right: 0; bottom: 0; flex-direction: row;">
                <ui:VisualElement style="flex-grow: 0; height: 100%; width: 30%; align-content: center; justify-content: center; align-items: center;">
                    <ui:Button text="" name="ExitButton" style="height: 38%; background-image: url(&quot;project://database/Assets/Textures/UI/placeholder_ch1_icon.png?fileID=2800000&amp;guid=1cb3768a1791945c89e6f0ada4c1cae5&amp;type=3#placeholder_ch1_icon&quot;); border-bottom-width: 0; border-left-width: 0; border-top-width: 0; border-right-width: 0; width: 60%; -unity-background-scale-mode: scale-to-fit; background-color: rgba(188, 188, 188, 0);"/>
                    <ui:Label text="Log Off" style="font-size: 20px;"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 0; height: 100%; width: 30%; align-content: center; justify-content: center; align-items: center;">
                    <ui:Button text="" name="ResumeButton" style="height: 38%; background-image: url(&quot;project://database/Assets/Textures/UI/placeholder_ch2_icon.png?fileID=2800000&amp;guid=7b0114ad40a9a4fb9add678d6433e1c4&amp;type=3#placeholder_ch2_icon&quot;); border-bottom-width: 0; border-left-width: 0; border-top-width: 0; border-right-width: 0; width: 60%; -unity-background-scale-mode: scale-to-fit; background-color: rgba(188, 188, 188, 0);"/>
                    <ui:Label text="Resume" style="font-size: 20px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </DesktopWindowElement>
</ui:UXML>
