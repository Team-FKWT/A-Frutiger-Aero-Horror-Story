<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; flex-direction: row; justify-content: space-between;">
        <ui:VisualElement style="flex-grow: 1;"/>
        <ui:VisualElement style="flex-grow: 1; width: 25%; align-content: center; align-items: center; justify-content: center;">
            <ui:Image name="KeycardReader" style="width: 35%; height: 40%; background-color: rgb(128, 128, 128); align-items: center;">
                <ui:Image name="KeycardLight" style="width: 50%; height: 10%; border-left-width: 2px; border-bottom-width: 2px; border-right-width: 2px; border-left-color: rgb(96, 96, 96); border-right-color: rgb(96, 96, 96); border-top-color: rgb(96, 96, 96); border-bottom-color: rgb(96, 96, 96); background-color: rgb(152, 152, 158);"/>
            </ui:Image>
        </ui:VisualElement>
        <ui:VisualElement name="Keycards" style="flex-grow: 1; justify-content: center; align-items: center;"/>
    </ui:VisualElement>
</ui:UXML>
