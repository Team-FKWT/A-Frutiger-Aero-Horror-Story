    <ui:VisualElement style="flex-grow: 1; width: 1280px; height: 720px; background-image: url(&quot;project://database/Assets/Textures/UI/placeholder_bkg.png?fileID=2800000&amp;guid=01c3b06bfec174b7bb656aa6eda6c25f&amp;type=3#placeholder_bkg&quot;); align-items: center;">
