<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/IntroMenu/IntroMenu.uss?fileID=7433441132597879392&amp;guid=45d3d4aee5e47441698d484a378d9141&amp;type=3#IntroMenu"/>
    <ui:VisualElement name="Background" style="flex-grow: 1; width: 1280px; height: 720px; background-image: url(&quot;project://database/Assets/Textures/UI/placeholder_bkg.png?fileID=2800000&amp;guid=01c3b06bfec174b7bb656aa6eda6c25f&amp;type=3#placeholder_bkg&quot;); align-items: center; cursor: url(&quot;project://database/Assets/Textures/UI/placeholder_cursor.png?fileID=2800000&amp;guid=3adf0a07636bd4d71a56169a9816f676&amp;type=3#placeholder_cursor&quot;);">
        <ui:VisualElement name="CentredDiv" style="flex-grow: 1; align-content: flex-end; width: 100%; justify-content: center; align-items: center; flex-direction: row;"/>
        <ui:VisualElement name="BottomDiv" style="flex-grow: 0; flex-direction: row; width: 100%; height: 10%; justify-content: space-between; align-items: center; align-content: auto; align-self: center;">
            <ui:Button text="?" name="CreditsButton" style="left: auto; margin-bottom: 1%; height: 80%; margin-left: 1%; width: 56px;"/>
            <ui:Button text="Quit" name="QuitButton" style="bottom: 0; right: 0; width: 84px; position: relative; height: 80%; background-position-x: left 0; background-position-y: bottom 0; margin-right: 1%; margin-bottom: 1%;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
